# Authoritative persistence
POSTGRES_DB=mosaic
POSTGRES_USER=mosaic
POSTGRES_PASSWORD=mosaic
POSTGRES_PORT=5432
EXECUTION_DATABASE_URL=postgresql+psycopg://mosaic:mosaic@127.0.0.1:5432/mosaic
EXECUTION_WORKSPACE=.mosaic_workspace
EXECUTION_SCHEMA_VERSION=0.1
EVENT_SNAPSHOT_INTERVAL=100

# Scheduling: production is strict; do not silently claim OR-Tools while falling back.
SCHEDULER_POLICY=ortools
SCHEDULER_ALLOW_FALLBACK=false
SCHEDULER_WEIGHT_LATENCY=1.0
SCHEDULER_WEIGHT_TOKEN=1.0
SCHEDULER_WEIGHT_ENERGY=1.0
SCHEDULER_WEIGHT_FAILURE=10.0
SCHEDULER_WEIGHT_MIGRATION=2.0
POSTERIOR_DECAY_PER_DAY=0.02
MAX_TASK_RETRIES=1

# Memory
MEMORY_REDIS_URL=redis://127.0.0.1:6379/0
MEMORY_OBJECT_STORE_DIR=.mosaic_workspace/object_store
MEMORY_SNAPSHOT_EVERY_N_EVENTS=100

# MQTT Agent planning
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=mosaic/v3

# Tool boundary
ALLOWED_COMMANDS=python,python.exe
TOOL_TIMEOUT_S=30

# Read-only observability console
CONSOLE_HOST=0.0.0.0
CONSOLE_PORT=8080
